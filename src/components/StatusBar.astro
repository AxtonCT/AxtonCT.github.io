---
import { AUTHOR, BUILD } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const postCount = String(posts.length).padStart(2, '0');
---

<footer class="status" aria-label="status bar">
	<span class="seg"><b>★ Axton-Index</b></span>

	<span class="seg marquee hide-sm" aria-hidden="true">
		<span>
			Frontend × AI Visual Design · 把工程师怎么思考，带进设计怎么落地。 ·
			Currently writing on ComfyUI workflow & diffusion fundamentals. ·
			{AUTHOR.city} · 远程协作 ·
			Frontend × AI Visual Design · 把工程师怎么思考，带进设计怎么落地。 ·
			{AUTHOR.city} · 远程协作 ·
		</span>
	</span>

	<span class="seg hide-sm">Posts <b>{postCount}</b></span>
	<span class="seg hide-sm">Build <b>{BUILD}</b></span>
	<span class="seg hide-sm">Tz <b>{AUTHOR.tz}</b></span>
	<span class="seg right">© {new Date().getFullYear()} — {AUTHOR.name}</span>
</footer>

<style>
	.status {
		position: fixed;
		bottom: 0; left: 0; right: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: auto 1fr auto auto auto auto;
		align-items: center;
		gap: 18px;
		padding: 10px 32px;
		background: linear-gradient(0deg, rgba(10, 10, 10, .9), rgba(10, 10, 10, .3));
		backdrop-filter: blur(10px);
		border-top: 1px solid var(--hair);
		font-family: var(--font-mono);
		font-size: 10.5px;
		letter-spacing: .06em;
		color: var(--ink-mid);
		text-transform: uppercase;
	}
	.status b {
		color: var(--ink);
		font-weight: 500;
		letter-spacing: .04em;
		text-transform: none;
	}
	.status .seg { display: flex; align-items: center; gap: 8px; }
	.status .right { justify-self: end; font-variant-numeric: tabular-nums; }
	.status .marquee {
		overflow: hidden;
		white-space: nowrap;
		color: var(--ink-mid);
	}
	.status .marquee > span {
		display: inline-block;
		animation: status-scroll 60s linear infinite;
		padding-right: 60px;
	}
	@keyframes status-scroll {
		0%   { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	@media (max-width: 920px) {
		.status {
			grid-template-columns: auto 1fr auto;
			gap: 12px;
			padding: 8px 14px;
			font-size: 10px;
		}
		.status .seg.hide-sm { display: none; }
	}
	@media (max-width: 560px) {
		.status { padding: 7px 12px; }
	}
</style>
