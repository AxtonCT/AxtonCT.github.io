---
import { getCollection } from 'astro:content';

interface Props {
	marquee?: string;
}

const { marquee = 'CURRENTLY WRITING ON COMFYUI WORKFLOW · MIDJOURNEY V7 STUDIES · ASTRO 6 NOTES · CURSOR PRODUCTIVITY DATA' } = Astro.props;

const posts = await getCollection('blog');
const count = String(posts.length).padStart(2, '0');
const year = new Date().getFullYear();
// Stable build hash — derived from post count + year so it changes only when content does
const buildHash = (count + year.toString(36) + 'axt')
	.split('')
	.reduce((h, c) => ((h << 5) - h + c.charCodeAt(0)) | 0, 0)
	.toString(16)
	.slice(-6);
---

<footer class="status-bar" role="contentinfo">
	<div class="container">
		<div class="strip">
			<div class="cell brand">
				<span class="star" aria-hidden="true">★</span>
				<span>Axton-Index</span>
			</div>
			<div class="cell domain hide-sm">
				<span class="uppercase muted-2">FRONTEND × AI VISUAL DESIGN</span>
			</div>
			<div class="cell tagline hide-md">
				<span class="muted-3">把"工程师怎么思考"带进"设计怎么落地"。</span>
			</div>
			<div class="cell marquee-cell">
				<div class="marquee" aria-hidden="true">
					<span class="marquee-track">
						<span class="marquee-content">· {marquee} ·</span>
						<span class="marquee-content" aria-hidden="true">· {marquee} ·</span>
					</span>
				</div>
			</div>
			<div class="cell meta posts hide-sm">
				<span class="muted-3">POSTS</span>
				<span class="muted-1">{count}</span>
			</div>
			<div class="cell meta build hide-sm">
				<span class="muted-3">BUILD</span>
				<code class="muted-1">#{buildHash}</code>
			</div>
			<div class="cell meta tz hide-md">
				<span class="muted-3">TZ</span>
				<span class="muted-1">UTC+8</span>
			</div>
			<div class="cell copyright">
				<span class="muted-3">© {year} — AXTONDEX</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.status-bar {
		border-top: 1px solid var(--line);
		background: var(--bg);
		padding: 14px 0;
		font-family: var(--font-mono);
		font-size: var(--text-mono-sm);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.strip {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		overflow: hidden;
		white-space: nowrap;
	}
	.cell {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex: 0 0 auto;
	}
	.cell.marquee-cell {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
	}
	.brand {
		color: var(--fg);
	}
	.star {
		font-size: 11px;
		color: var(--fg);
	}
	.marquee {
		overflow: hidden;
		mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 24px,
			#000 calc(100% - 24px),
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent 0,
			#000 24px,
			#000 calc(100% - 24px),
			transparent 100%
		);
	}
	.marquee-track {
		display: inline-flex;
		gap: 0;
		animation: scroll 60s linear infinite;
	}
	.marquee-content {
		display: inline-block;
		padding-right: 32px;
		color: var(--mute-2);
	}
	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
	code {
		font-family: var(--font-mono);
		background: transparent;
		padding: 0;
		font-size: inherit;
	}

	@media (max-width: 920px) {
		.status-bar {
			padding: 10px 0;
		}
		.strip {
			gap: var(--s-3);
		}
	}

	@media (max-width: 560px) {
		.status-bar {
			padding: 9px 0;
			font-size: 10px;
		}
		.strip {
			gap: 10px;
		}
	}
</style>
