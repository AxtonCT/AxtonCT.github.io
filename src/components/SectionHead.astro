---
interface Props {
	n: string;
	label: string;
	title: string;
	titleDim?: string;
	countLabel?: string;
	count?: string | number;
	countSuffix?: string;
}
const { n, label, title, titleDim, countLabel, count, countSuffix } = Astro.props;
---

<div class="section-head">
	<span class="nlabel">№ {n} · {label}</span>
	<h2>
		{title}
		{titleDim && <span class="dim"> {titleDim}</span>}
	</h2>
	{count != null && (
		<span class="count">
			{countLabel && <>{countLabel}</>}
			<b>{count}</b>
			{countSuffix && <>{countSuffix}</>}
		</span>
	)}
</div>
