---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { index?: string };

const { href, class: className, index, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={['nav-link', className, { active: isActive }]} {...props}>
	{index && <span class="idx hide-sm">{index}</span>}
	<span class="label"><slot /></span>
</a>

<style>
	.nav-link {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		padding: 6px 0;
		color: var(--mute-2);
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.nav-link:hover {
		color: var(--fg);
	}
	.nav-link.active {
		color: var(--fg);
	}
	.nav-link.active .label::after {
		content: '';
		display: block;
		height: 1px;
		background: var(--fg);
		margin-top: 4px;
	}
	.idx {
		color: var(--mute-3);
		font-size: var(--text-mono-sm);
	}
	.nav-link.active .idx {
		color: var(--mute-2);
	}
</style>
