---
import FormattedDate from './FormattedDate.astro';

interface Props {
	index: number;
	href: string;
	title: string;
	subtitle?: string;
	tag?: string;
	pubDate: Date;
	readMinutes?: number;
}

const { index, href, title, subtitle, tag, pubDate, readMinutes } = Astro.props;
const indexStr = String(index).padStart(3, '0');
---

<a class="entry" href={href}>
	<div class="idx mono muted-3">{indexStr}</div>

	<div class="body">
		<h3 class="title">{title}</h3>
		{subtitle && <p class="subtitle mono muted-2">{subtitle}</p>}
	</div>

	<div class="tag mono uppercase hide-sm">
		{tag ? <span class="muted-2">{tag}</span> : <span class="muted-4">—</span>}
	</div>

	<div class="date mono muted-2 hide-sm">
		<FormattedDate date={pubDate} />
	</div>

	<div class="read mono muted-2 hide-sm">
		{readMinutes ? <span>{readMinutes} min →</span> : <span class="muted-4">→</span>}
	</div>
</a>

<style>
	.entry {
		display: grid;
		grid-template-columns: 60px 1fr 160px 120px 80px;
		align-items: baseline;
		gap: var(--s-5);
		padding: var(--s-6) 0;
		border-bottom: 1px solid var(--line);
		color: var(--fg);
		transition: background 0.15s ease, padding 0.15s ease;
	}
	.entry:hover {
		background: rgba(250, 250, 250, 0.025);
	}
	.entry:hover .title {
		color: var(--fg);
	}
	.idx {
		font-size: var(--text-mono);
	}
	.title {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(22px, 2.4vw, 32px);
		line-height: 1.15;
		letter-spacing: -0.03em;
		margin: 0;
		color: var(--fg);
		text-wrap: balance;
	}
	.subtitle {
		margin: 8px 0 0;
		font-size: var(--text-mono);
		letter-spacing: 0.03em;
	}
	.tag,
	.date,
	.read {
		font-size: var(--text-mono);
		letter-spacing: 0.06em;
	}
	.read {
		text-align: right;
	}

	@media (max-width: 920px) {
		.entry {
			grid-template-columns: 48px 1fr 110px 90px;
			gap: var(--s-4);
		}
		.entry .read {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.entry {
			grid-template-columns: 36px 1fr;
			gap: var(--s-3);
			padding: var(--s-4) 0;
		}
		.title {
			font-size: 20px;
		}
		.subtitle {
			margin-top: 4px;
		}
	}
</style>
