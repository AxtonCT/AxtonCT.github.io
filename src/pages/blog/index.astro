---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostEntry from '../../components/PostEntry.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tags = Array.from(new Set(posts.map((p) => p.data.tag).filter(Boolean)));
---

<BaseLayout title={`Writing · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>

	<section class="pagehead">
		<div class="container">
			<div class="crumbs">№ 02 <span class="arr">/</span> <b>Writing</b></div>
			<h1>Writing.</h1>
			<p class="sub">
				长文为主、慢更新。<span class="cjk"> 每篇都按"过半年回头看仍然觉得有用"的标准写。</span>
			</p>
			<div class="row">
				<span><b>{posts.length}</b> entries</span>
				<span>2026 onward</span>
				{tags.length > 0 && (
					<span>tags · <b>{tags.join(' · ')}</b></span>
				)}
			</div>
		</div>
	</section>

	<section class="section" style="border-top:0;padding-top:0">
		<div class="container">
			<div class="index-list">
				{posts.map((p, i) => <PostEntry post={p} index={i} />)}
			</div>
		</div>
	</section>

</BaseLayout>

<style>
	.cjk { font-family: var(--font-prose); font-style: italic; color: var(--ink); }
</style>
