---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`404 · ${SITE_TITLE}`} description="Page not found">
	<section class="nf">
		<div class="big">
			<span class="sig">SIG · 11 · Path not in the index.</span>
			<h1 class="num">4<span class="slash">/</span>04</h1>
			<p class="msg">
				这条路径不存在，或者从来没存在过。 — 可能是我重构时把它带走了。<br />
				试试 <a class="underline" href="/">index</a> 或 <a class="underline" href="/blog/">writing</a>。
			</p>
		</div>
		<div class="actions">
			<a href="/">cd / index</a>
			<a href="/blog/">/ writing</a>
			<a class="ghost" href="/about/">/ about</a>
		</div>
	</section>
</BaseLayout>

<style>
	.nf {
		min-height: calc(100vh - 200px);
		display: grid;
		grid-template-rows: 1fr auto;
		padding: 120px 32px 80px;
		gap: 40px;
	}
	.big {
		align-self: center;
		justify-self: center;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 30px;
	}
	.big .num {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(160px, 32vw, 480px);
		line-height: .85;
		letter-spacing: -.05em;
		margin: 0;
	}
	.big .num .slash { color: var(--ink-mid); font-weight: 300; }
	.big .sig {
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: .12em;
		color: var(--ink-mid);
		text-transform: uppercase;
	}
	.big .msg {
		color: var(--ink-dim);
		font-size: 18px;
		line-height: 1.5;
		max-width: 520px;
		margin: 0 auto;
	}
	.actions {
		justify-self: center;
		display: flex;
		gap: 32px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: .1em;
		text-transform: uppercase;
	}
	.actions a {
		color: var(--ink);
		padding: 14px 24px;
		border: 1px solid var(--muted);
		transition: background .2s, color .2s, border-color .2s;
	}
	.actions a:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
	.actions a.ghost { border-color: transparent; color: var(--ink-mid); }
	.actions a.ghost:hover { color: var(--ink); background: transparent; }

	@media (max-width: 920px) {
		.nf { padding: 100px 22px 60px; }
		.actions { gap: 10px; flex-wrap: wrap; justify-content: center; }
		.actions a { padding: 12px 18px; font-size: 10.5px; }
		.big .msg { font-size: 15px; }
		.big .num { font-size: clamp(140px, 40vw, 200px); }
	}
</style>
