---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PostEntry from '../components/PostEntry.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, BUILD } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = posts.find((p) => p.data.featured) || posts[0];
const featIdx = featured ? posts.indexOf(featured) : 0;
const featNum = featured ? String(posts.length - featIdx).padStart(3, '0') : '001';
const featTag = featured?.data.tag?.replace('-', ' / ');
const pad2 = (n: number) => String(n).padStart(2, '0');
const featDate = featured ? `${featured.data.pubDate.getFullYear()}.${pad2(featured.data.pubDate.getMonth() + 1)}.${pad2(featured.data.pubDate.getDate())}` : '';

const stack = [
	{ g: 'Frontend',  n: '01', items: [['React',95],['Next.js',90],['TypeScript',92],['Vue · Nuxt',78],['Astro',70],['Vite',88]] },
	{ g: 'AI Visual', n: '02', items: [['Midjourney',85],['ComfyUI',78],['Stable Diffusion',72],['Photoshop',60],['Figma',80]] },
	{ g: 'Tooling',   n: '03', items: [['Cursor',85],['pnpm',90],['Linear',70],['Raycast',82],['Tailwind',88]] },
] as const;

const now = [
	{ en: 'Deep-diving <b>ComfyUI</b> workflow — graph thinking vs prompt engineering.', cjk: '节点图思维 vs prompt 工程' },
	{ en: 'Reading on <b>diffusion fundamentals</b> — from DDPM to flow matching.', cjk: 'DDPM → Flow Matching' },
	{ en: "Building a small tool that feeds <b>Figma frames</b> to SD for variations.", cjk: 'Figma → SD 变体小工具' },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<section class="hero">
		<div class="frame-corners"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>

		<div class="topline">
			<div>
				<span>Index № 01</span>
				<b>{AUTHOR.name} / {AUTHOR.handle}</b>
			</div>
			<div>
				<span>{AUTHOR.role}</span>
				<b>v1.0 · build {BUILD}</b>
			</div>
			<div>
				<span>{AUTHOR.city} / 远程</span>
				<b>{AUTHOR.tz} · est. 2026</b>
			</div>
		</div>

		<h1 class="display hero-headline">
			<span class="row">Axton<span class="ordinal">⁰¹</span></span>
			<span class="row"><span class="light">Dex.</span></span>
		</h1>

		<div class="botline">
			<p class="manifesto">
				{AUTHOR.tagline}<br />
				<span class="cjk">{AUTHOR.taglineZh}</span>
			</p>
			<div class="scroll-cue">
				<span>scroll · index</span>
				<span class="arrow"></span>
			</div>
		</div>
	</section>

	<section class="manifesto-block">
		<div class="col-l">
			<div>// manifesto</div>
			<div style="margin-top:6px;color:var(--ink-mid)">№ 01 — 02</div>
		</div>
		<div class="col-r">
			<p>I write at the seam between <b>engineering</b> and <b>visual craft</b> — where bundle sizes meet brush strokes, and where a <i>workflow</i> is the deliverable.</p>
			<p><span class="cjk">不追新闻、不堆 todo、不做教程。</span> Just notes that should still feel useful six months later.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHead
				n="02"
				label="Writing"
				title="Selected"
				titleDim="notes."
				countLabel="Total"
				count={String(posts.length).padStart(2, '0')}
				countSuffix="posts"
			/>

			{featured && (
				<a class="feature" href={`/blog/${featured.id}/`}>
					<div class="vis">
						<span class="tag">Featured{featTag ? ` · ${featTag}` : ''}</span>
						{featured.data.heroImage && (
							<Image src={featured.data.heroImage} alt="" width={720} height={576} />
						)}
						<span class="num">{featNum} / {featDate}</span>
					</div>
					<div>
						<div class="lab">№ 02.1 · Featured</div>
						<h3>{featured.data.title}</h3>
						{featured.data.subtitle && <div class="en">{featured.data.subtitle}</div>}
						<p>{featured.data.description}</p>
						<span class="more">Read full essay <span>→</span></span>
					</div>
				</a>
			)}

			<div class="index-list" style="margin-top:20px">
				{posts.slice(0, 4).map((p, i) => <PostEntry post={p} index={i} />)}
			</div>

			<p style="margin-top:40px;text-align:center">
				<a class="underline view-all" href="/blog/">View all {posts.length} entries →</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHead
				n="03"
				label="Stack"
				title="Tools,"
				titleDim="tuned."
				countLabel="Self-rated"
				count={stack.reduce((s, c) => s + c.items.length, 0)}
				countSuffix="tools"
			/>
			<div class="stack-grid">
				{stack.map((col) => (
					<div class="stack-col">
						<h4>{col.g}<span class="n">№ 03.{col.n}</span></h4>
						{col.items.map(([name, lvl]) => (
							<div class="stack-row">
								<span class="n">{name}</span>
								<span class="bar-wrap">
									<span class="bar">
										{Array.from({ length: 10 }, (_, k) => (
											<i class={`seg ${k < Math.round((lvl as number) / 10) ? 'on' : ''}`}></i>
										))}
									</span>
									<span class="pct">{lvl}</span>
								</span>
							</div>
						))}
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<SectionHead
				n="04"
				label="Now"
				title="What I'm"
				titleDim="on, right now."
				countLabel="Updated"
				count="05·20"
				countSuffix="2026"
			/>
			<div class="now-grid">
				<div class="l">
					<div class="label">// /now movement</div>
					<p>这一栏每月更新一次，记录目前真正在花时间的三件事。</p>
					<p class="updated">Last sync — 2026.05.20</p>
				</div>
				<div class="r">
					<ol>
						{now.map((n) => (
							<li>
								<Fragment set:html={n.en} />
								<br />
								<span class="cjk">{n.cjk}</span>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<section class="contact">
		<span class="label" style="display:block">№ 05 · Contact</span>
		<h2>Say hi. <span class="light">Or just lurk.</span></h2>
		<div class="links">
			<a href={`mailto:${AUTHOR.email}`}><span class="glyph">@</span>{AUTHOR.email}</a>
			<a href={AUTHOR.github} target="_blank" rel="noopener me"><span class="glyph">GH</span>github.com/AxtonCT</a>
			<a href={AUTHOR.twitter} target="_blank" rel="noopener me"><span class="glyph">TW</span>twitter.com/AxtonCT</a>
			<a href={AUTHOR.rss}><span class="glyph">RSS</span>rss.xml</a>
		</div>
	</section>

</BaseLayout>

<style>
	.cjk { font-family: var(--font-prose); font-style: italic; color: var(--ink); }

	.hero {
		min-height: calc(100vh - 60px);
		padding: 80px 32px 60px;
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 24px;
		position: relative;
		overflow: hidden;
	}
	.frame-corners > i {
		position: absolute;
		width: 18px; height: 18px;
		border-color: var(--ink-mid);
		border-style: solid;
		border-width: 0;
		pointer-events: none;
	}
	.frame-corners .tl { top: 80px; left: 32px; border-top-width: 1px; border-left-width: 1px; }
	.frame-corners .tr { top: 80px; right: 32px; border-top-width: 1px; border-right-width: 1px; }
	.frame-corners .bl { bottom: 60px; left: 32px; border-bottom-width: 1px; border-left-width: 1px; }
	.frame-corners .br { bottom: 60px; right: 32px; border-bottom-width: 1px; border-right-width: 1px; }

	.topline {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 24px;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		text-transform: uppercase;
		letter-spacing: .1em;
	}
	.topline > div { display: flex; flex-direction: column; gap: 6px; }
	.topline > div b {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: 13px;
		letter-spacing: 0;
		font-weight: 500;
		text-transform: none;
	}
	.topline > div:nth-child(2) { text-align: center; }
	.topline > div:last-child   { text-align: right; align-items: flex-end; }

	.hero-headline { align-self: center; }

	.botline {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 24px;
		align-items: end;
	}
	.manifesto {
		max-width: 580px;
		color: var(--ink-dim);
		font-size: 18px;
		line-height: 1.5;
		text-wrap: pretty;
	}
	.manifesto b { color: var(--ink); font-weight: 500; }
	.scroll-cue {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: .1em;
		color: var(--ink-mid);
		text-transform: uppercase;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 6px;
	}
	.scroll-cue .arrow {
		width: 1px; height: 30px;
		background: var(--ink-mid);
		position: relative;
	}
	.scroll-cue .arrow::after {
		content: ""; position: absolute;
		left: -3px; bottom: 0;
		width: 7px; height: 7px;
		border-right: 1px solid var(--ink-mid);
		border-bottom: 1px solid var(--ink-mid);
		transform: rotate(45deg) translate(-3px, -3px);
	}

	.manifesto-block {
		padding: 140px 32px;
		border-top: 1px solid var(--hair);
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 80px;
		max-width: var(--container);
		margin: 0 auto;
	}
	.manifesto-block .col-l {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		letter-spacing: .1em;
		text-transform: uppercase;
		position: sticky;
		top: 120px;
		align-self: start;
	}
	.manifesto-block .col-r {
		font-family: var(--font-display);
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.15;
		letter-spacing: -.018em;
		color: var(--ink-dim);
		font-weight: 300;
		max-width: 980px;
		text-wrap: balance;
	}
	.manifesto-block .col-r b { color: var(--ink); font-weight: 500; }
	.manifesto-block .col-r p { margin: 0 0 28px; }
	.manifesto-block .col-r p:last-child { margin-bottom: 0; }

	.stack-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--hair);
		border: 1px solid var(--hair);
	}
	.stack-col { background: var(--bg); padding: 32px; }
	.stack-col h4 {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		letter-spacing: .12em;
		text-transform: uppercase;
		margin: 0 0 24px;
		font-weight: 500;
		display: flex;
		justify-content: space-between;
	}
	.stack-col h4 .n { color: var(--muted); }
	.stack-row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 14px;
		align-items: center;
		padding: 14px 0;
		border-bottom: 1px solid var(--hair);
	}
	.stack-row:last-child { border-bottom: 0; }
	.stack-row .n { font-size: 18px; font-weight: 500; letter-spacing: -.01em; }
	.stack-row .bar-wrap { display: flex; align-items: center; }
	.stack-row .bar { display: flex; gap: 2px; align-items: center; }
	.stack-row .bar .seg { width: 6px; height: 14px; background: var(--faint); }
	.stack-row .bar .seg.on { background: var(--ink); }
	.stack-row .pct {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		margin-left: 10px;
		font-variant-numeric: tabular-nums;
		min-width: 24px;
		text-align: right;
	}

	.now-grid {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 60px;
		align-items: start;
	}
	.now-grid .l { position: sticky; top: 120px; }
	.now-grid .l .label { margin-bottom: 14px; display: block; }
	.now-grid .l p {
		color: var(--ink-dim);
		font-size: 13px;
		line-height: 1.5;
		margin: 14px 0 0;
	}
	.now-grid .l p.updated {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		letter-spacing: .04em;
		margin-top: 18px;
	}
	.now-grid .r ol { list-style: none; margin: 0; padding: 0; counter-reset: nw; }
	.now-grid .r li {
		counter-increment: nw;
		display: grid;
		grid-template-columns: 60px 1fr;
		gap: 24px;
		padding: 28px 0;
		border-top: 1px solid var(--hair);
		font-size: clamp(20px, 2.2vw, 28px);
		line-height: 1.3;
		font-weight: 400;
		letter-spacing: -.01em;
		color: var(--ink);
		text-wrap: balance;
	}
	.now-grid .r li::before {
		content: "§ " counter(nw, decimal-leading-zero);
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-mid);
		letter-spacing: .06em;
		align-self: center;
	}
	.now-grid .r li:last-child { border-bottom: 1px solid var(--hair); }
	.now-grid .r li b { color: var(--ink); font-weight: 500; }

	.contact {
		padding: 160px 32px 100px;
		border-top: 1px solid var(--hair);
		display: grid;
		grid-template-columns: 1fr;
		gap: 60px;
		text-align: center;
	}
	.contact h2 {
		font-size: clamp(48px, 9vw, 140px);
		line-height: .95;
		letter-spacing: -.04em;
		margin: 0;
		font-weight: 500;
	}
	.contact h2 .light { color: var(--ink-dim); font-weight: 300; }
	.contact .links {
		display: flex;
		justify-content: center;
		gap: 48px;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: .06em;
		color: var(--ink-mid);
		text-transform: uppercase;
	}
	.contact .links a {
		color: var(--ink);
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding-bottom: 4px;
		border-bottom: 1px solid var(--muted);
		transition: border-color .2s;
	}
	.contact .links a:hover { border-color: var(--ink); }
	.contact .links a .glyph { color: var(--ink-mid); }

	.view-all {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: var(--ink-mid);
		padding-bottom: 4px;
	}

	@media (max-width: 920px) {
		.hero { padding: 74px 22px 40px; gap: 28px; min-height: calc(100vh - 60px); }
		.frame-corners .tl, .frame-corners .bl { left: 22px; }
		.frame-corners .tr, .frame-corners .br { right: 22px; }
		.frame-corners .tl, .frame-corners .tr { top: 74px; }
		.frame-corners .bl, .frame-corners .br { bottom: 40px; }
		.frame-corners > i { width: 14px; height: 14px; }
		.topline { grid-template-columns: 1fr; gap: 14px; font-size: 10.5px; }
		.topline > div:nth-child(2), .topline > div:last-child { text-align: left; align-items: flex-start; }
		.topline > div b { font-size: 13px; }
		.botline { grid-template-columns: 1fr; gap: 20px; align-items: start; }
		.manifesto { font-size: 16px; max-width: none; }
		.scroll-cue { align-items: flex-start; }
		.scroll-cue .arrow { height: 24px; }

		.manifesto-block { grid-template-columns: 1fr; gap: 24px; padding: 60px 22px; }
		.manifesto-block .col-l { position: static; }
		.manifesto-block .col-r { font-size: 24px; line-height: 1.2; }

		.stack-grid { grid-template-columns: 1fr; }
		.stack-col { padding: 22px; }
		.stack-row .n { font-size: 16px; }
		.stack-row .bar .seg { width: 5px; height: 12px; }

		.now-grid { grid-template-columns: 1fr; gap: 24px; }
		.now-grid .l { position: static; }
		.now-grid .r li { grid-template-columns: 40px 1fr; gap: 14px; padding: 20px 0; font-size: 18px; }

		.contact { padding: 90px 22px 70px; gap: 36px; }
		.contact h2 { font-size: clamp(40px, 11vw, 72px); }
		.contact .links { gap: 18px; font-size: 11.5px; flex-direction: column; align-items: center; }
	}

	@media (max-width: 560px) {
		.hero { padding: 70px 18px 32px; }
		.contact { padding: 70px 18px 60px; }
	}
</style>
