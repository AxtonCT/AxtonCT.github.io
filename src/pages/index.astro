---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const featuredHref = featured ? `/blog/${featured.id}/` : '/blog/';

const stack = [
	{ key: 'Frontend', items: ['React', 'Next.js', 'Vue', 'Nuxt', 'TypeScript', 'Tailwind'] },
	{ key: 'AI Visual', items: ['Midjourney', 'ComfyUI', 'Stable Diffusion', 'ControlNet'] },
	{ key: 'Tools', items: ['Astro', 'Vite', 'Cursor', 'Claude Code', 'Vercel'] },
];

const now = [
	{ verb: 'Studying', subject: 'ComfyUI workflow & SD model fine-tuning' },
	{ verb: 'Reading', subject: 'AI 视觉设计论文 + 工程实践' },
	{ verb: 'Building', subject: 'this site, ongoing' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero frame">
				<div class="container">
					<div class="topline">
						<span class="topline-item mono uppercase">
							<span class="muted-3">N°</span>
							<span class="muted-1">01</span>
							<span class="muted-4">/</span>
							<span class="muted-1">Index</span>
						</span>
						<span class="topline-item mono uppercase muted-2 hide-md">
							Frontend × AI Visual Design
						</span>
						<span class="topline-item mono uppercase muted-2 right">
							{new Date().getFullYear()}
						</span>
					</div>

					<h1 class="hero-title display">AxtonDex<span class="period">.</span></h1>

					<p class="hero-tag">
						<span class="zh">把"工程师怎么思考"带进"设计怎么落地"。</span>
						<span class="en mono uppercase">Frontend × AI Visual Design</span>
					</p>

					<div class="hero-footer mono uppercase">
						<a href="/blog" class="hero-cta">
							<span class="muted-3">→ Read</span> <span class="muted-1">Writing</span>
						</a>
						<a href="/about" class="hero-cta">
							<span class="muted-3">→ About</span> <span class="muted-1">AxtonDex</span>
						</a>
					</div>
				</div>
			</section>

			{featured && (
				<section class="featured">
					<div class="container">
						<div class="section-label mono uppercase">
							<span class="muted-3">N° 01.A</span>
							<span class="slash muted-4">/</span>
							<span class="muted-1">Featured</span>
						</div>
						<a class="featured-card" href={featuredHref}>
							<div class="featured-meta mono uppercase">
								<span class="muted-2">{featured.data.tag ?? '—'}</span>
								<span class="muted-4">·</span>
								<span class="muted-2">
									<FormattedDate date={featured.data.pubDate} />
								</span>
							</div>
							<h2 class="featured-title display">{featured.data.title}</h2>
							{featured.data.subtitle && (
								<p class="featured-sub mono uppercase muted-2">{featured.data.subtitle}</p>
							)}
							<p class="featured-desc">{featured.data.description}</p>
							<span class="featured-arrow mono uppercase muted-1">Read →</span>
						</a>
					</div>
				</section>
			)}

			<section class="stack">
				<div class="container">
					<div class="section-label mono uppercase">
						<span class="muted-3">N° 01.B</span>
						<span class="slash muted-4">/</span>
						<span class="muted-1">Stack</span>
					</div>
					<div class="stack-grid">
						{stack.map((group) => (
							<div class="stack-group">
								<div class="stack-key mono uppercase muted-3">{group.key}</div>
								<ul class="stack-items">
									{group.items.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="now">
				<div class="container">
					<div class="section-label mono uppercase">
						<span class="muted-3">N° 01.C</span>
						<span class="slash muted-4">/</span>
						<span class="muted-1">Now</span>
					</div>
					<ol class="now-list">
						{now.map((item, i) => (
							<li class="now-item">
								<span class="now-idx mono muted-3">{String(i + 1).padStart(2, '0')}</span>
								<span class="now-verb mono uppercase muted-2">{item.verb}</span>
								<span class="now-subject">{item.subject}</span>
							</li>
						))}
					</ol>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.hero {
				padding: var(--s-9) 0 var(--s-10);
				border-bottom: 1px solid var(--line);
			}
			.topline {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--s-5);
				margin-bottom: var(--s-9);
			}
			.topline-item {
				display: inline-flex;
				gap: 6px;
			}
			.topline-item.right {
				text-align: right;
			}
			.hero-title {
				font-family: var(--font-display);
				font-weight: 800;
				font-size: var(--display-hero);
				line-height: 0.9;
				letter-spacing: -0.06em;
				margin: 0;
				color: var(--fg);
			}
			.hero-title .period {
				color: var(--mute-3);
			}
			.hero-tag {
				margin: var(--s-7) 0 0;
				max-width: 720px;
				color: var(--fg);
				font-size: 20px;
				line-height: 1.45;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.hero-tag .zh {
				color: var(--fg);
			}
			.hero-tag .en {
				color: var(--mute-2);
				font-size: var(--text-mono);
			}
			.hero-footer {
				margin-top: var(--s-9);
				display: inline-flex;
				gap: var(--s-7);
				flex-wrap: wrap;
			}
			.hero-cta {
				color: var(--fg);
				display: inline-flex;
				gap: 4px;
				font-size: var(--text-mono);
			}
			.hero-cta:hover {
				opacity: 0.7;
			}

			.featured,
			.stack,
			.now {
				padding: var(--s-9) 0;
				border-bottom: 1px solid var(--line);
			}
			.section-label {
				display: inline-flex;
				gap: 6px;
				margin-bottom: var(--s-7);
			}
			.slash {
				margin: 0 2px;
			}

			.featured-card {
				display: block;
				padding: var(--s-7);
				border: 1px solid var(--line);
				color: var(--fg);
				transition: border-color 0.2s ease, background 0.2s ease;
			}
			.featured-card:hover {
				border-color: var(--line-strong);
				background: rgba(250, 250, 250, 0.02);
			}
			.featured-meta {
				display: inline-flex;
				gap: 8px;
				margin-bottom: var(--s-4);
				font-size: var(--text-mono);
			}
			.featured-title {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: clamp(36px, 5vw, 64px);
				line-height: 1;
				letter-spacing: -0.04em;
				margin: 0;
				color: var(--fg);
				text-wrap: balance;
			}
			.featured-sub {
				margin: var(--s-3) 0 0;
				font-size: var(--text-mono);
			}
			.featured-desc {
				margin: var(--s-5) 0 var(--s-6);
				max-width: 640px;
				color: var(--mute-1);
				font-size: 16px;
				line-height: 1.6;
			}
			.featured-arrow {
				display: inline-block;
				font-size: var(--text-mono);
			}

			.stack-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--s-7);
			}
			.stack-key {
				margin-bottom: var(--s-4);
				font-size: var(--text-mono);
			}
			.stack-items {
				list-style: none;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			.stack-items li {
				font-family: var(--font-display);
				font-weight: 500;
				font-size: 22px;
				letter-spacing: -0.01em;
				color: var(--mute-1);
			}

			.now-list {
				list-style: none;
				padding: 0;
				display: flex;
				flex-direction: column;
			}
			.now-item {
				display: grid;
				grid-template-columns: 40px 100px 1fr;
				gap: var(--s-4);
				align-items: baseline;
				padding: var(--s-4) 0;
				border-bottom: 1px solid var(--line);
				font-size: 18px;
			}
			.now-idx {
				font-size: var(--text-mono);
			}
			.now-verb {
				font-size: var(--text-mono);
			}
			.now-subject {
				font-family: var(--font-display);
				font-weight: 500;
				font-size: 22px;
				letter-spacing: -0.01em;
				color: var(--fg);
			}

			@media (max-width: 920px) {
				.hero {
					padding: var(--s-7) 0 var(--s-8);
				}
				.topline {
					margin-bottom: var(--s-7);
				}
				.hero-tag {
					margin-top: var(--s-6);
					font-size: 18px;
				}
				.hero-footer {
					margin-top: var(--s-7);
					gap: var(--s-5);
				}
				.featured,
				.stack,
				.now {
					padding: var(--s-7) 0;
				}
				.section-label {
					margin-bottom: var(--s-5);
				}
				.featured-card {
					padding: var(--s-5);
				}
				.stack-grid {
					grid-template-columns: 1fr;
					gap: var(--s-5);
				}
				.now-item {
					grid-template-columns: 32px 80px 1fr;
				}
				.now-subject,
				.stack-items li {
					font-size: 19px;
				}
			}

			@media (max-width: 560px) {
				.hero {
					padding: var(--s-6) 0 var(--s-7);
				}
				.topline {
					flex-direction: column;
					align-items: flex-start;
					gap: 8px;
				}
				.topline-item.right {
					text-align: left;
				}
				.hero-title {
					font-size: clamp(56px, 22vw, 110px);
				}
				.hero-tag {
					font-size: 17px;
				}
				.hero-footer {
					margin-top: var(--s-6);
					flex-direction: column;
					gap: var(--s-3);
				}
				.featured,
				.stack,
				.now {
					padding: var(--s-6) 0;
				}
				.featured-title {
					font-size: clamp(32px, 8vw, 48px);
				}
				.now-item {
					grid-template-columns: 28px 1fr;
					row-gap: 4px;
				}
				.now-verb {
					grid-column: 2;
				}
				.now-subject {
					grid-column: 2;
					font-size: 17px;
				}
				.stack-items li {
					font-size: 18px;
				}
			}
		</style>
	</body>
</html>
