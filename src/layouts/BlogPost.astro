---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, subtitle, tag, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-head">
					<div class="container">
						<div class="meta-row mono uppercase">
							<span class="meta-item">
								<span class="muted-3">Tag</span>
								<span class="muted-1">{tag ?? 'Meta'}</span>
							</span>
							<span class="meta-item">
								<span class="muted-3">Date</span>
								<span class="muted-1"><FormattedDate date={pubDate} /></span>
							</span>
							{updatedDate && (
								<span class="meta-item">
									<span class="muted-3">Updated</span>
									<span class="muted-1"><FormattedDate date={updatedDate} /></span>
								</span>
							)}
							<a class="meta-item back" href="/blog">
								<span class="muted-3">←</span>
								<span class="muted-1">Writing</span>
							</a>
						</div>

						<h1 class="post-title display">{title}</h1>
						{subtitle && <p class="post-subtitle mono uppercase muted-2">{subtitle}</p>}
					</div>
				</header>

				{heroImage && (
					<div class="hero-image">
						<Image width={1280} height={720} src={heroImage} alt="" />
					</div>
				)}

				<div class="post-body">
					<div class="prose">
						<slot />
					</div>
				</div>

				<div class="post-foot">
					<div class="container">
						<a class="post-back mono uppercase" href="/blog">
							<span class="muted-3">→</span>
							<span class="muted-1">All writing</span>
						</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<style>
			.post-head {
				padding: var(--s-9) 0 var(--s-7);
				border-bottom: 1px solid var(--line);
			}
			.meta-row {
				display: flex;
				gap: var(--s-6);
				flex-wrap: wrap;
				margin-bottom: var(--s-7);
				font-size: var(--text-mono);
			}
			.meta-item {
				display: inline-flex;
				gap: 6px;
				align-items: baseline;
			}
			.back {
				margin-left: auto;
			}
			.back:hover {
				opacity: 0.7;
			}
			.post-title {
				font-family: var(--font-display);
				font-weight: 500;
				font-size: clamp(36px, 6vw, 88px);
				line-height: 1;
				letter-spacing: -0.05em;
				margin: 0;
				color: var(--fg);
				text-wrap: balance;
				max-width: 14ch;
			}
			.post-subtitle {
				margin: var(--s-4) 0 0;
				font-size: var(--text-mono);
				letter-spacing: 0.06em;
			}

			.hero-image {
				margin: 0;
				border-bottom: 1px solid var(--line);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
			}

			.post-body {
				padding: var(--s-9) var(--gutter);
			}

			.post-foot {
				padding: var(--s-7) 0;
				border-top: 1px solid var(--line);
			}
			.post-back {
				display: inline-flex;
				gap: 6px;
				color: var(--fg);
				font-size: var(--text-mono);
			}

			@media (max-width: 920px) {
				.post-head {
					padding: var(--s-7) 0 var(--s-5);
				}
				.meta-row {
					gap: var(--s-4);
					margin-bottom: var(--s-5);
				}
				.post-body {
					padding: var(--s-7) var(--gutter);
				}
				.post-foot {
					padding: var(--s-6) 0;
				}
			}

			@media (max-width: 560px) {
				.post-head {
					padding: var(--s-6) 0 var(--s-4);
				}
				.meta-row {
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: var(--s-3);
					margin-bottom: var(--s-5);
				}
				.back {
					margin-left: 0;
					grid-column: 1 / -1;
				}
				.post-title {
					max-width: none;
				}
				.post-body {
					padding: var(--s-6) var(--gutter);
				}
			}
		</style>
	</body>
</html>
