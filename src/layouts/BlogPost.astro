---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, heroImage, subtitle, tag, readMinutes } = Astro.props;

const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const slugPath = Astro.url.pathname.replace(/\/$/, '').replace(/^\/blog\//, '');
const idx = all.findIndex((p) => p.id === slugPath);
const prev = idx >= 0 ? all[(idx + all.length - 1) % all.length] : null;
const next = idx >= 0 ? all[(idx + 1) % all.length] : null;

const num = idx >= 0 ? String(all.length - idx).padStart(3, '0') : '—';
const pad2 = (n: number) => String(n).padStart(2, '0');
const dStr = `${pubDate.getFullYear()}.${pad2(pubDate.getMonth() + 1)}.${pad2(pubDate.getDate())}`;
const tagLabel = tag ? tag.replace('-', ' / ') : '';
const readStr = readMinutes ? `${readMinutes} min` : '— min';
---

<BaseLayout title={title} description={description}>
	<article class="post-hero">
		<div class="meta-row">
			<span>№ <b>{num}</b></span>
			<span>Date · <b>{dStr}</b></span>
			<span>Read · <b>{readStr}</b></span>
			{tag && <span>Tag · <b>{tagLabel}</b></span>}
			<span></span>
			<a class="underline back" href="/blog/">← Back to index</a>
		</div>

		<h1>{title}</h1>
		{subtitle && <div class="lede">{subtitle}</div>}

		{heroImage && (
			<div class="vis">
				<span class="corner tl">№ {num} · plate</span>
				{tag && <span class="corner tr">{tagLabel}</span>}
				<Image src={heroImage} alt="" width={1320} height={566} />
				<span class="corner bl">slug · {slugPath}</span>
				<span class="corner br">{dStr}</span>
			</div>
		)}
	</article>

	<div class="post-body">
		<slot />

		{updatedDate && (
			<p class="updated"><em>Last updated · <FormattedDate date={updatedDate} /></em></p>
		)}

		<hr />
		<blockquote>"过半年回头看仍然觉得有用" — 是这里唯一的发布标准。</blockquote>
	</div>

	{(prev || next) && (
		<nav class="post-nav">
			{prev && (
				<a href={`/blog/${prev.id}/`}>
					<span class="lbl">← Previous</span>
					<span class="t">{prev.data.title}</span>
				</a>
			)}
			{next && (
				<a class="next" href={`/blog/${next.id}/`}>
					<span class="lbl">Next →</span>
					<span class="t">{next.data.title}</span>
				</a>
			)}
		</nav>
	)}
</BaseLayout>

<style>
	.post-hero {
		max-width: var(--container);
		margin: 0 auto;
		padding: 140px 32px 60px;
		border-bottom: 1px solid var(--hair);
		display: grid;
		grid-template-columns: 1fr;
		gap: 28px;
	}
	.meta-row {
		display: grid;
		grid-template-columns: auto auto auto auto 1fr auto;
		gap: 32px;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--hair);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: .06em;
		color: var(--ink-mid);
		text-transform: uppercase;
		align-items: baseline;
	}
	.meta-row b { color: var(--ink); font-weight: 500; }
	.meta-row .back { justify-self: end; cursor: pointer; }

	.post-hero h1 {
		font-family: var(--font-display);
		font-size: clamp(40px, 7vw, 100px);
		line-height: .95;
		letter-spacing: -.025em;
		margin: 0 0 14px;
		font-weight: 500;
		max-width: 1100px;
		text-wrap: balance;
	}
	.lede {
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--ink-mid);
		letter-spacing: .02em;
		margin-top: 4px;
	}

	.vis {
		aspect-ratio: 21 / 9;
		background: var(--bg-card);
		border: 1px solid var(--hair);
		position: relative;
		overflow: hidden;
		margin-top: 24px;
	}
	.vis :global(img) {
		position: absolute; inset: 0;
		width: 100%; height: 100%;
		object-fit: cover;
	}
	.vis .corner {
		position: absolute;
		font-family: var(--font-mono);
		font-size: 10.5px;
		color: var(--ink);
		letter-spacing: .1em;
		text-transform: uppercase;
		background: rgba(0, 0, 0, .55);
		padding: 3px 8px;
		backdrop-filter: blur(4px);
		border: 1px solid rgba(250, 250, 250, .15);
		z-index: 2;
	}
	.vis .corner.tl { top: 14px; left: 14px; }
	.vis .corner.tr { top: 14px; right: 14px; }
	.vis .corner.bl { bottom: 14px; left: 14px; }
	.vis .corner.br { bottom: 14px; right: 14px; }

	.updated {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-mid);
		margin: 40px 0 0;
	}

	.post-nav {
		max-width: var(--container);
		margin: 0 auto;
		padding: 60px 32px 120px;
		border-top: 1px solid var(--hair);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1px;
		background: var(--hair);
	}
	.post-nav a {
		background: var(--bg);
		padding: 36px 32px;
		text-decoration: none;
		color: var(--ink);
		display: flex;
		flex-direction: column;
		gap: 10px;
		transition: background .2s;
	}
	.post-nav a:hover { background: var(--hover); }
	.post-nav a .lbl {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: .1em;
		color: var(--ink-mid);
		text-transform: uppercase;
	}
	.post-nav a .t {
		font-family: var(--font-display);
		font-size: 22px;
		line-height: 1.2;
		letter-spacing: -.012em;
		font-weight: 500;
		text-wrap: balance;
	}
	.post-nav a.next { text-align: right; align-items: flex-end; }

	@media (max-width: 920px) {
		.post-hero { padding: 100px 22px 30px; gap: 20px; }
		.meta-row {
			grid-template-columns: repeat(2, auto);
			gap: 10px 22px;
			font-size: 10px;
			padding-bottom: 14px;
			align-items: start;
		}
		.meta-row > *:nth-child(5) { display: none; }
		.meta-row .back { grid-column: 1 / -1; justify-self: start; margin-top: 4px; }
		.post-hero h1 { font-size: clamp(36px, 9vw, 56px); }
		.vis { aspect-ratio: 3 / 2; margin-top: 14px; }
		.vis .corner { font-size: 9px; }
		.post-nav { grid-template-columns: 1fr; gap: 1px; padding: 40px 22px 80px; }
		.post-nav a { padding: 24px 22px; }
		.post-nav a.next { text-align: left; align-items: flex-start; }
	}
	@media (max-width: 560px) {
		.post-hero { padding: 90px 18px 24px; }
		.post-hero h1 { font-size: 36px; }
	}
</style>
